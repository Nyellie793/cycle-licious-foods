# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (Developers -> API keys). Use sk_test_... while testing.
STRIPE_SECRET_KEY=sk_test_xxx

# Optional but recommended
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, lets the API save orders
STRIPE_WEBHOOK_SECRET=whsec_xxx                   # marks orders as paid
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # your live Vercel URL in production
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cycle_licious_foods/
